# Discord bot token, from the Developer Portal's Bot page.
DISCORD_TOKEN=YOUR_DISCORD_BOT_TOKEN_HERE

# Your server's ID. Enables instant guild-scoped slash command sync
# during testing (right-click your server icon with Developer Mode on
# -> Copy Server ID).
GUILD_ID=YOUR_GUILD_ID_HERE

# Path to a downloaded rars.jar (RARS RISC-V simulator), used by
# emulator.py to verify lab submissions.
# https://github.com/TheThirdOne/rars/releases/download/v1.6/rars1_6.jar
RARS_JAR_PATH=./tools/rars1_6.jar

# Hugging Face token, used by agent.py's OpenAI-compatible client
# pointed at Hugging Face's router.
HF_TOKEN=YOUR_HF_TOKEN_HERE

# Model to use on Hugging Face's router. Defaults to Qwen/Qwen3-8B if unset.
HF_MODEL=Qwen/Qwen3-8B
